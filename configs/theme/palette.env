# HackermacUI theme palette (GitHub Dark family)
#
# Single shell-sourceable source of truth for HackermacUI's colors. Plain
# hex colors use `#RRGGBB`; strip fill alphas are separate 0.0-1.0 floats so
# each consumer composes what it needs (JankyBorders wants 0xAARRGGBB,
# SwiftBar `color=` wants bare hex, the JXA renderer wants NSColor components).
#
# Consumers: configs/borders/bordersrc and the Ghostty focus colors (checked by
# scripts/validate-configs.py). The SwiftBar workspace strip keeps its own
# design and does not read this file.

# Base surface colors.
HACKERMACUI_COLOR_BG="#0d1117"
HACKERMACUI_COLOR_SURFACE="#161b22"
HACKERMACUI_COLOR_FG="#e6edf3"
HACKERMACUI_COLOR_MUTED="#8b949e"
HACKERMACUI_COLOR_SEPARATOR="#30363d"

# Semantic colors. HACKERMACUI_COLOR_FOCUS is the one focus color shared by
# the border, the strip's focused segment, and Ghostty's selection/cursor.
HACKERMACUI_COLOR_FOCUS="#7ee787"
HACKERMACUI_COLOR_INFO="#79c0ff"
HACKERMACUI_COLOR_WARN="#d29922"
HACKERMACUI_COLOR_ERROR="#ff7b72"

# Workspace-strip segment fills (hex + separate alpha 0.0-1.0).
HACKERMACUI_STRIP_FOCUSED_FILL="#12261a"
HACKERMACUI_STRIP_FOCUSED_FILL_ALPHA="0.85"
HACKERMACUI_STRIP_OCCUPIED_FILL="#161b22"
HACKERMACUI_STRIP_OCCUPIED_FILL_ALPHA="0.65"
HACKERMACUI_STRIP_EMPTY_FILL="#0d1117"
HACKERMACUI_STRIP_EMPTY_FILL_ALPHA="0.45"
